# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun.
# .env.local GitHub'a gitmez. GERÇEK DEĞERLERİ BU DOSYAYA YAZMAYIN.
# Değerler: Supabase > Project Settings > API Keys

# Tarayıcı ve sunucu (yetkiyi RLS belirler)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Yalnızca sunucu tarafı. NEXT_PUBLIC_ öneki ALMAZ, tarayıcıya gönderilmez.
SUPABASE_SECRET_KEY=

# Yalnızca geliştirici bilgisayarı: SQL testleri için doğrudan veritabanı bağlantısı
SUPABASE_DB_URL=
