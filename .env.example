# Bu dosyayı .env olarak kopyalayın ve kendi bilgilerinizi yazın.
# .env dosyası .gitignore'dadır; GERÇEK ŞİFRELERİ BU DOSYAYA YAZMAYIN.
# Bağlantı dizeleri: Supabase > Project Settings > Database > Connection string

# Streamlit uygulaması (amir, İK, kiosk ekranları)
PDKS_UYGULAMA_DB_URL=postgresql://pdks_uygulama.PROJE_KODU:SIFRE@aws-0-REGION.pooler.supabase.com:5432/postgres

# Gece işi (Python betiği, Windows Görev Zamanlayıcı)
PDKS_GECE_ISI_DB_URL=postgresql://pdks_gece_isi.PROJE_KODU:SIFRE@aws-0-REGION.pooler.supabase.com:5432/postgres

# Yalnızca kurulum ve testler için (postgres kullanıcısı). Uygulamada KULLANMAYIN.
PDKS_ADMIN_DB_URL=postgresql://postgres.PROJE_KODU:SIFRE@aws-0-REGION.pooler.supabase.com:5432/postgres
